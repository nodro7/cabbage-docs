---
// Temporary home page content. The new Home replaces it (build step 5).
import Button from '../components/site/Button.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';
---

<SiteLayout
  title="Cabbage"
  description="Cabbage is a framework for audio software development using Csound. Create VST, AU, and CLAP plugins with ease."
>
  <section class="cb-section temp-hero">
    <div class="container">
      <img src="/img/cabbage-mark.svg" alt="" width="120" height="112" />
      <h1 class="cb-display">Cabbage 3</h1>
      <p class="cb-lead">
        Welcome to the homepage for Cabbage 3. For the latest updates, documentation, and downloads, visit the links
        below.
      </p>
      <div class="temp-hero__actions">
        <Button href="/download/">Download</Button>
        <Button href="/docs/" variant="quiet">Docs</Button>
        <Button href="/videos/" variant="quiet">Videos</Button>
        <Button href={site.forumUrl} variant="quiet">Forum</Button>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .temp-hero .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: var(--cb-section-y);
  }
  .temp-hero .cb-lead {
    max-width: 640px;
  }
  .temp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 12px;
  }
</style>
