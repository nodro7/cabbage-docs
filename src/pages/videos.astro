---
// Temporary videos page content. The Learn page replaces it (build step 4),
// and the list moves to src/data/videos.ts.
// To add a video until then: copy the ID from the YouTube URL (?v=THE_ID_HERE)
// and add one line to the list below with its title.
import Button from '../components/site/Button.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';

const VIDEOS = [
  // Optional per-video `zoom` overrides the default 1.1 thumbnail zoom.
  { id: 'tBcK2GkMOQQ', title: 'Cabbage 3 Overview and Features', zoom: 1.15 },
  { id: 'Z8OCGgWn42A', title: '1 - Installing Cabbage 3' },
  { id: 'e9FaofZeC8U', title: '2 - Using the Cabbage VS Code Extension' },
  { id: '3c-1U2vR54E', title: '3 - File structure in Csound 7 and Cabbage 3' },
  { id: 'wD1TFHvFFXQ', title: '4 - Variables in Csound 7 and Cabbage 3' },
  { id: 'AHvR9NoPlBo', title: '5 - Opcodes in Csound 7 and Cabbage 3' },
  { id: 'Dme2FJ_3H3s', title: '6 - Note events with Cabbage 3' },
  { id: 'K6-pg1RPRfw', title: '7 - Widgets with Cabbage 3' },
  { id: '2fD5TbgqH2Q', title: '8 - Building a simple synth plugin with Cabbage 3' },
  { id: 'lKrG_--aVGk', title: '9 - Exporting instruments in Cabbage 3' },
  { id: 'ML7iq1PYhU8', title: '10 - Custom UIs with Cabbage 3' },
];
---

<SiteLayout
  title="Videos"
  description="Video tutorials for Cabbage 3: installation, Csound basics, widgets, and exporting instruments."
>
  <section class="cb-section cb-section--chrome">
    <div class="container temp-head">
      <h1 class="cb-title">Videos</h1>
      <p class="cb-lead">
        Tutorials and overviews for Cabbage 3, from installation to building and exporting your own instruments.
      </p>
      <Button href={site.playlistUrl} variant="quiet">Watch full playlist on YouTube</Button>
    </div>
  </section>

  <section class="cb-section">
    <div class="container temp-grid">
      {
        VIDEOS.map((video) => (
          <article class="temp-video">
            <button
              type="button"
              class="temp-thumb"
              data-video-id={video.id}
              data-video-title={video.title}
              aria-label={'Play ' + video.title}
            >
              <img
                src={'https://i.ytimg.com/vi/' + video.id + '/maxresdefault.jpg'}
                onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')"
                alt=""
                loading="lazy"
                style={'transform: scale(' + (video.zoom ?? 1.1) + ')'}
              />
            </button>
            <a href={'https://www.youtube.com/watch?v=' + video.id + '&list=PLPHJAwcqO_C0'}>{video.title}</a>
          </article>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .temp-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-block: var(--cb-section-y-sm);
  }
  .temp-head .cb-lead {
    max-width: 640px;
  }
  .temp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 28px 24px;
    padding-block: var(--cb-section-y-sm);
  }
  .temp-video {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .temp-video a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cb-target);
    font-size: var(--cb-text-small);
    font-weight: 500;
    color: var(--cb-fg);
  }
  .temp-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--cb-line);
    border-radius: 10px;
    background: var(--cb-chrome);
    cursor: pointer;
  }
  .temp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .temp-thumb :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script is:inline>
  // Click-to-load YouTube embeds (privacy-enhanced, no cookies until play).
  (function () {
    function loadVideo(btn) {
      var id = btn.getAttribute('data-video-id');
      var title = btn.getAttribute('data-video-title') || 'YouTube video';
      if (!id || btn.querySelector('iframe')) return;
      var frame = document.createElement('iframe');
      frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
      frame.title = title;
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.allowFullscreen = true;
      btn.innerHTML = '';
      btn.appendChild(frame);
      btn.setAttribute('aria-label', title);
    }

    document.querySelectorAll('.temp-thumb[data-video-id]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        loadVideo(btn);
      });
    });
  })();
</script>
