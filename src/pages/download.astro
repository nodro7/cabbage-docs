---
// Temporary download page content. The Install page replaces it (build step 3),
// and the browser-side release lookup below goes away with it.
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';

const platforms = [
  { id: 'windows', label: 'Windows' },
  { id: 'macos', label: 'macOS' },
  { id: 'linux', label: 'Linux' },
];
---

<SiteLayout
  title="Download"
  description="Download the latest Cabbage 3 VS Code extension for Windows, macOS, and Linux."
>
  <section class="cb-section cb-section--chrome">
    <div class="container temp-head">
      <h1 class="cb-title">Download Cabbage 3</h1>
      <p class="cb-lead">
        Grab the latest VS Code extension (.vsix) for your platform. Links are fetched live from GitHub Releases.
      </p>
      <p class="cb-meta" id="release-tag">Finding latest release…</p>
    </div>
  </section>

  <section class="cb-section">
    <div class="container temp-body">
      <p class="cb-muted" id="status" role="status">Finding latest release…</p>
      <div class="temp-grid">
        {
          platforms.map((platform) => (
            <div class="temp-card" id={`card-${platform.id}`}>
              <h2 class="cb-h3">{platform.label}</h2>
              <p class="temp-card__meta" id={`meta-${platform.id}`}>
                …
              </p>
              <a href={site.releasesUrl} class="btn btn-quiet" id={`btn-${platform.id}`} aria-disabled="true">
                Download
              </a>
            </div>
          ))
        }
      </div>
      <p class="cb-muted">
        Need install steps? See the <a href="/docs/download/">Download and Install guide</a> or browse all versions on
        <a href={site.releasesUrl}>GitHub Releases</a>.
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .temp-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: var(--cb-section-y-sm);
  }
  .temp-head .cb-lead {
    max-width: 640px;
  }
  .temp-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: var(--cb-section-y-sm);
  }
  .temp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px;
  }
  .temp-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--cb-line);
    border-radius: var(--cb-radius-lg);
    background: var(--cb-chrome);
  }
  .temp-card__meta {
    min-height: 2.5em;
    font-family: var(--cb-font-mono);
    font-size: var(--cb-text-code);
    color: var(--cb-muted);
    word-break: break-all;
  }
  .btn[aria-disabled='true'] {
    opacity: 0.6;
    pointer-events: none;
  }
</style>

<script is:inline>
  // Fetch latest vscabbage release (incl. pre-releases) and wire up per-OS .vsix links.
  // NOTE: /releases/latest 404s while all releases are pre-releases, so we list instead.
  (function () {
    var API_URL = 'https://api.github.com/repos/rorywalsh/vscabbage/releases?per_page=5';
    var FALLBACK_URL = 'https://github.com/rorywalsh/vscabbage/releases';
    var platforms = ['windows', 'macos', 'linux'];

    function formatSize(bytes) {
      if (!bytes || bytes <= 0) return '';
      var units = ['B', 'KB', 'MB', 'GB'];
      var i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
      return (bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1) + ' ' + units[i];
    }

    function detectOS() {
      var platform = '';
      try {
        var uaData = navigator.userAgentData;
        if (uaData && uaData.platform) platform = uaData.platform.toLowerCase();
      } catch (e) {
        /* ignore */
      }
      var ua = (navigator.userAgent || '').toLowerCase() + ' ' + platform;
      if (ua.indexOf('win') !== -1) return 'windows';
      if (ua.indexOf('mac') !== -1 || ua.indexOf('darwin') !== -1) return 'macos';
      if (ua.indexOf('linux') !== -1 || ua.indexOf('x11') !== -1 || ua.indexOf('android') !== -1) return 'linux';
      return '';
    }

    function setRecommended(os) {
      if (!os) return;
      var btn = document.getElementById('btn-' + os);
      if (btn) {
        btn.classList.remove('btn-quiet');
        btn.classList.add('btn-primary');
      }
    }

    function setStatus(msg) {
      var el = document.getElementById('status');
      if (el) el.textContent = msg;
    }

    function setReleaseTag(release) {
      var el = document.getElementById('release-tag');
      if (!el) return;
      var text = 'Latest release: ' + (release.tag_name || release.name || 'latest');
      if (release.published_at) {
        var d = new Date(release.published_at);
        if (!isNaN(d)) text += ' · ' + d.toLocaleDateString();
      }
      el.textContent = text;
    }

    function wireAsset(os, asset) {
      var btn = document.getElementById('btn-' + os);
      var meta = document.getElementById('meta-' + os);
      if (!btn || !meta) return;
      if (asset && asset.browser_download_url) {
        btn.href = asset.browser_download_url;
        btn.removeAttribute('aria-disabled');
        var parts = [];
        if (asset.name) parts.push(asset.name);
        if (asset.size) parts.push(formatSize(asset.size));
        meta.textContent = parts.join(' · ') || asset.browser_download_url;
      } else {
        btn.href = FALLBACK_URL;
        btn.removeAttribute('aria-disabled');
        meta.textContent = 'Not found in latest release. See all releases';
      }
    }

    setRecommended(detectOS());

    fetch(API_URL, { headers: { Accept: 'application/vnd.github+json' } })
      .then(function (res) {
        if (!res.ok) throw new Error('GitHub API responded with ' + res.status);
        return res.json();
      })
      .then(function (releases) {
        var list = Array.isArray(releases) ? releases : [];
        var release =
          list.find(function (r) {
            return r && r.assets && r.assets.length > 0;
          }) || list[0];
        if (!release) throw new Error('No releases found');
        setReleaseTag(release);
        setStatus('');
        var assets = release.assets || [];
        platforms.forEach(function (os) {
          var match =
            assets.find(function (a) {
              return a && new RegExp(os + '\\.vsix$', 'i').test(a.name || '');
            }) ||
            assets.find(function (a) {
              return a && (a.name || '').toLowerCase().indexOf(os) !== -1;
            });
          wireAsset(os, match);
        });
      })
      .catch(function () {
        setReleaseTag({ tag_name: 'latest' });
        setStatus(
          'Could not fetch the latest release automatically (GitHub API limit or network issue). Please use the GitHub Releases page.'
        );
        platforms.forEach(function (os) {
          var btn = document.getElementById('btn-' + os);
          var meta = document.getElementById('meta-' + os);
          if (btn) {
            btn.href = FALLBACK_URL;
            btn.removeAttribute('aria-disabled');
          }
          if (meta) meta.textContent = 'See all downloads on GitHub';
        });
      });
  })();
</script>
