    <script is:inline>
      // Theme toggle (same as homepage)
      (function () {
        var storageKey = "starlight-theme";
        var select = document.getElementById("theme-select");

        function parseTheme(v) {
          return v === "dark" || v === "light" ? v : "auto";
        }

        function loadTheme() {
          return parseTheme(typeof localStorage !== "undefined" && localStorage.getItem(storageKey));
        }

        function getPreferred() {
          return matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }

        function updateIcon(theme) {
          var icons = document.querySelectorAll(".theme-toggle .label-icon");
          for (var i = 0; i < icons.length; i++) {
            icons[i].classList.toggle("active", icons[i].dataset.themeIcon === theme);
          }
        }

        function applyTheme(theme) {
          document.documentElement.dataset.theme = theme === "auto" ? getPreferred() : theme;
          if (typeof localStorage !== "undefined") {
            localStorage.setItem(storageKey, theme === "light" || theme === "dark" ? theme : "");
          }
          if (select) select.value = theme;
          updateIcon(theme);
        }

        applyTheme(loadTheme());

        if (select) {
          select.addEventListener("change", function (e) {
            applyTheme(parseTheme(e.target.value));
          });
        }

        matchMedia("(prefers-color-scheme: light)").addEventListener("change", function () {
          if (loadTheme() === "auto") applyTheme("auto");
        });
      })();
    </script>

    <script is:inline>
      // Fetch latest vscabbage release (incl. pre-releases) and wire up per-OS .vsix links.
      // NOTE: /releases/latest 404s while all releases are pre-releases, so we list instead.
      (function () {
        var API_URL = "https://api.github.com/repos/rorywalsh/vscabbage/releases?per_page=5";
        var FALLBACK_URL = "https://github.com/rorywalsh/vscabbage/releases";
        var platforms = ["windows", "macos", "linux"];

        function formatSize(bytes) {
          if (!bytes || bytes <= 0) return "";
          var units = ["B", "KB", "MB", "GB"];
          var i = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
          return (bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1) + " " + units[i];
        }

        function detectOS() {
          var platform = "";
          try {
            var uaData = navigator.userAgentData;
            if (uaData && uaData.platform) platform = uaData.platform.toLowerCase();
          } catch (e) { /* ignore */ }
          var ua = (navigator.userAgent || "").toLowerCase() + " " + platform;
          if (ua.indexOf("win") !== -1) return "windows";
          if (ua.indexOf("mac") !== -1 || ua.indexOf("darwin") !== -1) return "macos";
          if (ua.indexOf("linux") !== -1 || ua.indexOf("x11") !== -1 || ua.indexOf("android") !== -1) return "linux";
          return "";
        }

        function setRecommended(os) {
          if (!os) return;
          var card = document.getElementById("card-" + os);
          var btn = document.getElementById("btn-" + os);
          if (card) card.classList.add("recommended");
          if (btn) {
            btn.classList.remove("btn-secondary");
            btn.classList.add("btn-primary");
          }
        }

        function setStatus(msg, isError) {
          var el = document.getElementById("status");
          if (!el) return;
          el.textContent = msg;
          if (isError) el.classList.add("error");
          else el.classList.remove("error");
        }

        function setReleaseTag(release) {
          var el = document.getElementById("release-tag");
          if (!el) return;
          el.innerHTML = "";
          var strong = document.createElement("strong");
          strong.textContent = release.tag_name || release.name || "latest";
          el.appendChild(document.createTextNode("Latest release: "));
          el.appendChild(strong);
          if (release.published_at) {
            var d = new Date(release.published_at);
            if (!isNaN(d)) el.appendChild(document.createTextNode(" · " + d.toLocaleDateString()));
          }
        }

        function wireAsset(os, asset) {
          var btn = document.getElementById("btn-" + os);
          var meta = document.getElementById("meta-" + os);
          if (!btn || !meta) return;
          if (asset && asset.browser_download_url) {
            btn.href = asset.browser_download_url;
            btn.removeAttribute("aria-disabled");
            var parts = [];
            if (asset.name) parts.push(asset.name);
            if (asset.size) parts.push(formatSize(asset.size));
            meta.textContent = parts.join(" · ") || asset.browser_download_url;
          } else {
            btn.href = FALLBACK_URL;
            btn.removeAttribute("aria-disabled");
            meta.textContent = "Not found in latest release — see all releases";
          }
        }

        setRecommended(detectOS());

        fetch(API_URL, { headers: { Accept: "application/vnd.github+json" } })
          .then(function (res) {
            if (!res.ok) throw new Error("GitHub API responded with " + res.status);
            return res.json();
          })
          .then(function (releases) {
            var list = Array.isArray(releases) ? releases : [];
            var release = list.find(function (r) { return r && r.assets && r.assets.length > 0; }) || list[0];
            if (!release) throw new Error("No releases found");
            setReleaseTag(release);
            setStatus("");
            var assets = release.assets || [];
            platforms.forEach(function (os) {
              var match =
                assets.find(function (a) { return a && new RegExp(os + "\\.vsix$", "i").test(a.name || ""); }) ||
                assets.find(function (a) { return a && (a.name || "").toLowerCase().indexOf(os) !== -1; });
              // Final fallback: any .vsix (keeps page useful if naming changes)
              if (!match) {
                var vsix = assets.filter(function (a) { return /\.vsix$/i.test(a.name || ""); });
                match = vsix[platforms.indexOf(os)] || vsix[0];
              }
              wireAsset(os, match);
            });
          })
          .catch(function (err) {
            setReleaseTag({ tag_name: "latest", html_url: FALLBACK_URL });
            setStatus(
              "Could not fetch the latest release automatically (GitHub API limit or network issue). Please use the GitHub Releases page.",
              true
            );
            platforms.forEach(function (os) {
              var btn = document.getElementById("btn-" + os);
              var meta = document.getElementById("meta-" + os);
              if (btn) {
                btn.href = FALLBACK_URL;
                btn.removeAttribute("aria-disabled");
              }
              if (meta) meta.textContent = "See all downloads on GitHub";
            });
          });
      })();
    </script>
  </body>
</html>
