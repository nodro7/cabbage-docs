---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Download – Cabbage Audio</title>
    <meta
      name="description"
      content="Download the latest Cabbage 3 VS Code extension for Windows, macOS, and Linux."
    />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Dark is default */
      :root {
        --bg: #181818;
        --bg-alt: linear-gradient(135deg, #1a2332 0%, #1c2a2e 50%, #1a251a 100%);
        --text: #e0e0e0;
        --text-muted: #aaa;
        --text-faint: #999;
        --text-footer: #777;
        --border: #333;
        --accent: #4aa8e8;
        --accent-hover: #3b96d4;
        --card-bg: #1f1f1f;
        --card-hover-shadow: rgba(0, 0, 0, 0.3);
        --btn-secondary-bg: #222;
        --btn-secondary-hover: #2a2a2a;
      }

      /* Light mode overrides */
      :root[data-theme="light"] {
        --bg: #ffffff;
        --bg-alt: linear-gradient(135deg, #f0f8ff 0%, #e8f4f8 50%, #f5fff5 100%);
        --text: #1a1a2e;
        --text-muted: #555;
        --text-faint: #666;
        --text-footer: #888;
        --border: #eee;
        --accent: #3091d1;
        --accent-hover: #2578b3;
        --card-bg: #ffffff;
        --card-hover-shadow: rgba(0, 0, 0, 0.08);
        --btn-secondary-bg: #fff;
        --btn-secondary-hover: #f0f8ff;
      }

      .sr-only {
        clip-path: inset(50%);
        height: 1px;
        width: 1px;
        overflow: hidden;
        position: absolute;
        white-space: nowrap;
      }

      body {
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.6;
      }

      /* Navbar (same as homepage) */
      .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 2rem;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
        height: 4rem;
      }
      .navbar-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--accent);
        font-weight: 600;
        font-size: 1.5rem;
      }
      .navbar-brand img {
        height: 2.5rem;
        width: auto;
      }
      .navbar-links {
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }
      .navbar-links a {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.95rem;
        transition: color 0.2s;
      }
      .navbar-links a:hover {
        color: var(--accent);
      }
      .navbar-links a svg {
        width: 1rem;
        height: 1rem;
        color: var(--text-muted);
        transition: color 0.2s;
      }
      .navbar-links a:hover svg {
        color: var(--accent);
      }

      /* Theme toggle (same as homepage) */
      .theme-toggle {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        background: none;
        border: 0;
        padding: 0;
        cursor: pointer;
        color: var(--text-muted);
        transition: color 0.2s;
      }
      .theme-toggle:hover {
        color: var(--text);
      }
      .theme-toggle .label-icon {
        width: 0.875rem;
        height: 0.875rem;
        display: none;
      }
      .theme-toggle .label-icon.active {
        display: block;
      }
      .theme-toggle select {
        border: 0;
        padding-block: 0.625rem;
        padding-inline: calc(0.875rem + 0.5rem + 0.25rem) calc(1.25rem + 0.5rem + 0.25rem);
        margin-inline: -0.5rem;
        background-color: transparent;
        text-overflow: ellipsis;
        color: inherit;
        cursor: pointer;
        appearance: none;
        font-size: 0.95rem;
        font-family: inherit;
        width: 6.25em;
      }
      .theme-toggle option {
        background-color: var(--bg);
        color: var(--text);
      }
      .theme-toggle .icon {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
      }
      .theme-toggle .label-icon {
        inset-inline-start: 0;
      }
      .theme-toggle .caret {
        inset-inline-end: 0;
        width: 1.25rem;
        height: 1.25rem;
      }

      /* Hero */
      .hero {
        text-align: center;
        padding: 4rem 2rem 3rem;
        background: var(--bg-alt);
      }
      .hero h1 {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        font-size: 2.75rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text);
      }
      .hero h1 span {
        color: var(--accent);
      }
      .hero p {
        font-size: 1.15rem;
        color: var(--text-muted);
        max-width: 640px;
        margin: 1rem auto 0;
      }
      .release-tag {
        display: inline-block;
        margin-top: 1rem;
        font-size: 0.95rem;
        color: var(--text-muted);
      }
      .release-tag strong {
        color: var(--text);
        font-weight: 600;
      }

      /* Buttons (same as homepage) */
      .btn {
        cursor: pointer;
        box-sizing: border-box;
        appearance: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        vertical-align: middle;
        line-height: 1.5;
        user-select: none;
        inline-size: fit-content;
        max-width: min(100%, 100vw);
        border: 2px solid transparent;
        font-size: 1rem;
        overflow: hidden;
        white-space: nowrap;
        position: relative;
        touch-action: manipulation;
        transition-property: color, background-color, border-color, transform;
        transition-duration: 0.2s;
        transition-timing-function: ease-out;
        gap: 0.5rem;
        text-decoration: none;
        padding: 0.75rem 2rem;
        border-radius: 9999px;
      }
      .btn-primary {
        background: var(--accent);
        color: #fff;
      }
      .btn-primary:hover {
        background: var(--accent-hover);
      }
      .btn-secondary {
        background: var(--btn-secondary-bg);
        color: var(--accent);
        border: 2px solid var(--accent);
      }
      .btn-secondary:hover {
        background: var(--btn-secondary-hover);
      }
      .btn[aria-disabled="true"] {
        opacity: 0.6;
        cursor: wait;
        pointer-events: none;
      }

      /* Download cards */
      .download-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
        max-width: 960px;
        margin: 2.5rem auto;
        padding: 0 2rem;
      }
      .card {
        position: relative;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 1rem;
        padding: 2rem 1.5rem;
        text-align: center;
        transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
      }
      .card:hover {
        box-shadow: 0 8px 30px var(--card-hover-shadow);
      }
      .card.recommended {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent);
      }
      .card svg.os-icon {
        width: 2.5rem;
        height: 2.5rem;
        color: var(--accent);
        margin-bottom: 1rem;
      }
      .card h2 {
        font-size: 1.25rem;
        margin-bottom: 0.25rem;
      }
      .card .file-meta {
        font-size: 0.85rem;
        color: var(--text-faint);
        min-height: 2.5em;
        margin-bottom: 1.25rem;
        word-break: break-all;
      }
      .badge {
        position: absolute;
        top: -0.75rem;
        left: 50%;
        transform: translateX(-50%);
        background: var(--accent);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.75rem;
        border-radius: 9999px;
        display: none;
      }
      .card.recommended .badge {
        display: inline-block;
      }
      .status {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 2rem 1rem;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.95rem;
      }
      .status.error {
        color: #e06c75;
      }
      .status a {
        color: var(--accent);
      }
      .help-links {
        text-align: center;
        padding: 0 2rem 4rem;
        color: var(--text-muted);
      }
      .help-links a {
        color: var(--accent);
        text-decoration: none;
      }
      .help-links a:hover {
        text-decoration: underline;
      }

      /* Theme-aware logo swap */
      .logo-light { display: none; }
      .logo-dark  { display: inline; }
      :root[data-theme="light"] .logo-light { display: inline; }
      :root[data-theme="light"] .logo-dark  { display: none; }

      /* Responsive */
      @media (max-width: 768px) {
        .hero h1 {
          font-size: 2rem;
        }
        .download-grid {
          grid-template-columns: 1fr;
        }
        .navbar-links {
          gap: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      // Sync theme with Starlight's stored preference, falling back to system preference
      (function () {
        var stored = typeof localStorage !== "undefined" && localStorage.getItem("starlight-theme");
        var theme = stored || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
      })();
    </script>
