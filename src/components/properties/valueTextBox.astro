---
import { Code } from '@astrojs/starlight/components';
const description = `<p>When set to 1 this property will cause a text box to appear with the slider's values. The value box can be double-clicked to allow entering of precision values. Hitting enter will send the value to the widget.</p>`;
---
<div class="property-section">
  <Code code={`"valueTextBox": 0`} lang="json" />
  <Fragment set:html={description} />
</div>
