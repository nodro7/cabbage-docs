---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Enables file logging when in plugin mode. If <code>&quot;file&quot;</code> is left empty, the log file will default to the same name as the .csd file, but with a .log extension. The <code>&quot;replace&quot;</code> parameter determines whether Cabbage overwrites the log file on successive runs. File logging, along with this log overwriting, is enabled by default. Note the logger is only available in plugin builds.</p>`;
---
<div class="property-section">
  <Code code={`"logger":{
    "file":"",
    "replace": true,
    "enabled": true
}`} lang="json" />
  <Fragment set:html={description} />
</div>
