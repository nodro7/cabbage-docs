---
import { Code } from '@astrojs/starlight/components';
const description = `<ul>
<li>Colors accept named CSS colors, hex (e.g., #RRGGBB or #RRGGBBAA), or rgb/rgba strings.</li>
<li>Label typography is configured under <code>label.*</code>.</li>
<li>Ball appearance is configured under the <code>ball.*</code> object on the widget.</li>
</ul>`;
---
<div class="property-section">
  <Code code={`"style": {
  "opacity": 1,
  "borderRadius": 5,
  "borderWidth": 1,
  "borderColor": "#525252",
  "backgroundColor": "#323232"
},`} lang="json" />
  <Fragment set:html={description} />
</div>
