---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Octaves sets the number of octaves displayed in the keyboard widget. Set to -1 to show all available octaves.</p>`;
---
<div class="property-section">
  <Code code={`"octaves": -1`} lang="json" />
  <Fragment set:html={description} />
</div>
