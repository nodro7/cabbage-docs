---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Rotate defines rotation transformation for image widgets. x and y set the rotation center point, radians sets the rotation angle in radians.</p>`;
---
<div class="property-section">
  <Code code={`"rotate": {
    "x": 0,
    "y": 0,
    "radians": 0
}`} lang="json" />
  <Fragment set:html={description} />
</div>
