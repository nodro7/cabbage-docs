---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Mode determines the behavior of button widgets. Can be &quot;file&quot; for file selection, &quot;info&quot; for information display, or other widget-specific modes.</p>`;
---
<div class="property-section">
  <Code code={`"mode": "file"`} lang="json" />
  <Fragment set:html={description} />
</div>
