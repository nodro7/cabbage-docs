---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Sets the preferred channel and bus layout. You can add as many configuration strings as you like, e.g., <code>"2-2 2-1 1-1"</code>. You can also organise channels into buses by using a '.' operator. For example, the following string will group the inputs into a stereo bus, alongside a mono sidechain input: <code>"2.1-2"</code>.</p>`;
---
<div class="property-section">
  <Code code={`"channelConfig": "2-2"`} lang="json" />
  <Fragment set:html={description} />
</div>
