---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Integer values that set position and size on screen(in pixels).</p>`;
---
<div class="property-section">
  <Code code={`"bounds": {"left":0, "top":0, "width":100, "height":100}`} lang="json" />
  <Fragment set:html={description} />
</div>
