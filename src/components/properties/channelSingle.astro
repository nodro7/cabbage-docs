---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Channel defines a single communication channel for the widget. Some older widgets use this simple string format instead of the channels array.</p>`;
---
<div class="property-section">
  <Code code={`"channel": "widgetChannel"`} lang="json" />
  <Fragment set:html={description} />
</div>
