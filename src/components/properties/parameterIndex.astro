---
import { Code } from '@astrojs/starlight/components';
const description = `<p>ParameterIndex is used internally to track the widget's position in the parameter list for automation. Set automatically by Cabbage.</p>`;
---
<div class="property-section">
  <Code code={`"parameterIndex": -1`} lang="json" />
  <Fragment set:html={description} />
</div>
