---
import { Code } from '@astrojs/starlight/components';
const description = `<p>DecimalPlaces sets the number of decimal places displayed in value text for XY pads and other widgets that show numeric values.</p>`;
---
<div class="property-section">
  <Code code={`"decimalPlaces": 1`} lang="json" />
  <Fragment set:html={description} />
</div>
