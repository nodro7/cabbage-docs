---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Sets the text labels for the X and Y axes of the xyPad. Each axis can have its own label displayed in the value boxes at the bottom of the widget. If the labels contain separators like <code>/</code>, <code>|</code>, or <code>\\</code>, they will be automatically split during conversion from Cabbage2 format.</p>`;
---
<div class="property-section">
  <Code code={`"text": {"x": "X Label", "y": "Y Label"}`} lang="json" />
  <Fragment set:html={description} />
</div>
