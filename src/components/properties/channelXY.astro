---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Defines the channel configuration for the xyPad widget. The X axis is <code>channels[0]</code> and the Y axis is <code>channels[1]</code>:</p>
<ul>
<li><strong>id</strong>: Channel name for the axis value (used with <code>cabbageGetValue</code> to retrieve the position)</li>
<li><strong>event</strong>: Use <code>mouseDragX</code> for the X axis and <code>mouseDragY</code> for the Y axis</li>
</ul>
<p>Both channels can be read independently in your Csound code using <code>cabbageGetValue</code>.</p>`;
---
<div class="property-section">
  <Code code={`"channels": [
    {"id": "bandwidth", "event": "mouseDragX", "range": {"min": 10, "max": 2000, "defaultValue": 200, "skew": 1, "increment": 0.001}},
    {"id": "cutoff", "event": "mouseDragY", "range": {"min": 100, "max": 8000, "defaultValue": 1000, "skew": 1, "increment": 0.001}}
]`} lang="json" />
  <Fragment set:html={description} />
</div>
