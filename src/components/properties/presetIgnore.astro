---
import { Code } from '@astrojs/starlight/components';
const description = `<p>When set to true, the widget's value will be ignored when saving and loading presets. This is useful for widgets that should not retain their state between sessions.</p>`;
---
<div class="property-section">
  <Code code={`"presetIgnore": false`} lang="json" />
  <Fragment set:html={description} />
</div>
