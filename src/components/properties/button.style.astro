---
import { Code } from '@astrojs/starlight/components';
const description = `<ul>
<li>Colors accept named CSS colors, hex (e.g., #RRGGBB or #RRGGBBAA), or rgb/rgba strings.</li>
<li>The label text is configured under <code>label.text.on</code> and <code>label.text.off</code>.</li>
<li>Border radius/width/color control the button outline.</li>
</ul>`;
---
<div class="property-section">
  <Code code={`"style": {
  "opacity": 1,
  "borderRadius": 4,
  "borderWidth": 0,
  "borderColor": "#dddddd",

  "on": {
    "backgroundColor": "#3d800a",
    "textColor": "#dddddd"
  },
  "off": {
    "backgroundColor": "#3d800a",
    "textColor": "#dddddd"
  },
  "hover": {
    "backgroundColor": "#4ca10c",
    "textColor": "#dddddd"
  },
  "active": {
    "backgroundColor": "#2d6008",
    "textColor": "#dddddd"
  }
},`} lang="json" />
  <Fragment set:html={description} />
</div>
