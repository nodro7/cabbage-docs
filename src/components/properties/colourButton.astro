---
import { Code } from '@astrojs/starlight/components';
const description = `<p>This property sets the main colour of a button. Colour properties themselves can be any valid CSS or HTML color string. They can also accepts be hexadecimal strings, or RGB / RGBA array, where each channel ranges from 0 to 255. For example, <code>&quot;colour&quot;:{&quot;on&quot;:{&quot;fill&quot;:[0, 0, 255]}}</code> or <code>&quot;colour&quot;:{&quot;on&quot;:{&quot;fill&quot;:&quot;&quot;#ff0000&quot;}}</code>.</p>
<p>The <code>stroke</code> object set the outline colour and buttons.</p>`;
---
<div class="property-section">
  <Code code={`"colour": {
    "on": {
        "fill": "#0295cf",
        "stroke": {
            "colour": "#dddddd",
            "width": 2
        }
    },
    "off": {
        "fill": "#a8d388",
        "stroke": {
            "colour": "#dddddd",
            "width": 2
        }
    }
}`} lang="json" />
  <Fragment set:html={description} />
</div>
