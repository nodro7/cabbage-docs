---
import { Code } from '@astrojs/starlight/components';
const description = `<ul>
<li>Colors accept named CSS colors, hex (e.g., #RRGGBB or #RRGGBBAA), or rgb/rgba strings.</li>
<li>Label typography is configured under <code>label.*</code>.</li>
<li>When the group box contains children, its background becomes transparent so children are visible.</li></ul>`;
---
<div class="property-section">
  <Code code={`"style": {
  "opacity": 1,
  "borderRadius": 4,
  "borderWidth": 1,
  "borderColor": "#dddddd",
  "fill": "#888888"
},`} lang="json" />
  <Fragment set:html={description} />
</div>
