---
import { Code } from '@astrojs/starlight/components';
const description = `<p>This property sets the visible range of samples in a gentable. You can adjust these properties in real-time to enable zooming.</p>`;
---
<div class="property-section">
  <Code code={`"range": {"start":0, "end":-1}`} lang="json" />
  <Fragment set:html={description} />
</div>
