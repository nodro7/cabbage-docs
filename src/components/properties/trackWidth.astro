---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Sets the width of the horizontal/vertical slider track. Use a number (pixels) or <code>&quot;auto&quot;</code> to have it scale with the widget size.</p>
<ul>
<li>Type: number | &quot;auto&quot;</li>
<li>Default: &quot;auto&quot;</li>
<li>Applies to: horizontalSlider, verticalSlider (and any others that expose <code>style.track.width</code>)</li>
</ul>`;
---
<div class="property-section">
  <Code code={`"style": {
  "track": {
    "width": "auto"
  }
}`} lang="json" />
  <Fragment set:html={description} />
</div>
