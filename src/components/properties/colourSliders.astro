---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Colour properties can be any valid CSS or HTML color string. They can also accepts be hexadecimal strings, or RGB / RGBA array, where each channel ranges from 0 to 255. For example, <code>"colour":{"fill":[0, 0, 255]}</code> or <code>"colour":{"fill":""#ff0000"}</code>. <code>fill</code> sets the table colour, while <code>stroke.outline</code> sets the outline colour, while <code>tracker.width</code> will set teh width of the tracker in pixels.</p>`;
---
<div class="property-section">
  <Code code={`"colour": {
    "fill": "#0295cf",
    "stroke": {
        "colour": "#525252",
        "width": 2
    },
    "tracker": {
        "fill": "#93d200",
        "background": "#ffffff",
        "width": 20
    }
}`} lang="json" />
  <Fragment set:html={description} />
</div>
