---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Ball defines the XY pad's draggable indicator. size sets the ball diameter, fill sets the color, and borderWidth controls the border thickness.</p>`;
---
<div class="property-section">
  <Code code={`"ball": {
    "size": 20,
    "fill": "#93d200",
    "borderWidth": 2
}`} lang="json" />
  <Fragment set:html={description} />
</div>
