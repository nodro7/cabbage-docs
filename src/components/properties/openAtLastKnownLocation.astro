---
import { Code } from '@astrojs/starlight/components';
const description = `<p>OpenAtLastKnownLocation determines if file dialogs should remember and reopen at the last browsed directory.</p>`;
---
<div class="property-section">
  <Code code={`"openAtLastKnownLocation": true`} lang="json" />
  <Fragment set:html={description} />
</div>
