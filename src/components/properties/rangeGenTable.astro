---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Defines the range for the Y axis in a <code>genTable</code> widget.</p>
<ul>
<li><strong>min</strong>: Minimum value to be displayed (required)</li>
<li><strong>max</strong>: Maximum value to be displayed (required)</li>
</ul>`;
---
<div class="property-section">
  <Code code={`"range": {
    "min": -1,
    "max": 1
}`} lang="json" />
  <Fragment set:html={description} />
</div>
