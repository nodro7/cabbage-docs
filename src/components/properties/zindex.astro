---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Sets the stacking order of the widget. Widgets with higher zIndex values will appear in front of widgets with lower values. Default is 1.</p>`;
---
<div class="property-section">
  <Code code={`"zIndex": 1`} lang="json" />
  <Fragment set:html={description} />
</div>
