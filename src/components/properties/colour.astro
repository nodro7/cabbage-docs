---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Colour properties can be any valid CSS or HTML color string. They can also accepts be hexadecimal strings, or RGB / RGBA array, where each channel ranges from 0 to 255. For example, <code>"colour":{"fill":[0, 0, 255]}</code> or <code>"colour":{"fill":""#ff0000"}</code>.</p>

<p>The <code>stroke</code> object set the outline colour and width for any widget that supports it.</p>`;
---
<div class="property-section">
  <Code code={`"colour": {
    "fill": "#0295cf",
    "stroke": {
        "colour": "#dddddd",
        "width": 1
    }
}`} lang="json" />
  <Fragment set:html={description} />
</div>
