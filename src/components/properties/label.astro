---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Configures the widget label displayed near the control.</p>
<ul>
<li>text: string — the label text.</li>
<li>offsetY: number — vertical offset applied when the label is rendered outside the control (pixels).</li>
</ul>
<p>Typography (font size, color, family, alignment) is set via <code>style.label.*</code>.</p>`;
---
<div class="property-section">
  <Code code={`"label": {
  "text": "",
  "offsetY": 0
}`} lang="json" />
  <Fragment set:html={description} />
</div>
