---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Each xyPad axis has its own independent range, set on its channel entry (<code>channels[0].range</code> for X, <code>channels[1].range</code> for Y) with the following parameters:</p>
<ul>
<li><strong>min</strong>: Minimum value (required)</li>
<li><strong>max</strong>: Maximum value (required)</li>
<li><strong>defaultValue</strong>: Initial value (optional, defaults to min)</li>
<li><strong>skew</strong>: Skew factor for non-linear scaling (optional, default is 1 for linear). A value of 0.5 creates exponential scaling</li>
<li><strong>increment</strong>: Step size for value changes (optional, default is 0.001)</li>
</ul>
<blockquote><p><code>range()</code> cannot be updated or modified once a widget has been declared.</p></blockquote>`;
---
<div class="property-section">
  <Code code={`"channels": [
    {"id": "bandwidth", "event": "mouseDragX", "range": {"min": 10, "max": 2000, "defaultValue": 200, "skew": 1, "increment": 0.001}},
    {"id": "cutoff", "event": "mouseDragY", "range": {"min": 100, "max": 8000, "defaultValue": 1000, "skew": 1, "increment": 0.001}}
]`} lang="json" />
  <Fragment set:html={description} />
</div>
