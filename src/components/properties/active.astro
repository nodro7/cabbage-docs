---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Will deactivate a control if false is set (use 0/1 to update from Csound). Controls which are deactivated can still be updated from Csound. Any widget that has its active property set to false will allow all mouse-clicks to pass through it.</p>`;
---
<div class="property-section">
  <Code code={`"active": true`} lang="json" />
  <Fragment set:html={description} />
</div>
