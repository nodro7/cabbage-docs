---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Marker defines visual markers on range sliders. thickness sets marker width, start and end define the marker range as normalized values (0-1).</p>`;
---
<div class="property-section">
  <Code code={`"marker": {
    "thickness": 0.2,
    "start": 0.1,
    "end": 0.9
}`} lang="json" />
  <Fragment set:html={description} />
</div>
