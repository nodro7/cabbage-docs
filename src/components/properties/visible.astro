---
import { Code } from '@astrojs/starlight/components';
const description = `<p>A value of <code>true</code> will cause the widget to become invisible (use 0/1 to update from Csound). Widgets have their visibility set to <code>true</code> by default.</p>`;
---
<div class="property-section">
  <Code code={`"visible": true`} lang="json" />
  <Fragment set:html={description} />
</div>
