---
// First focusable element on every marketing page.
---

<a class="cb-skip" href="#main">Skip to content</a>

<style>
  .cb-skip {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 12px 16px;
    border-radius: var(--cb-radius);
    background: var(--cb-fg);
    color: var(--cb-bg);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .cb-skip:focus {
    transform: none;
  }
</style>
