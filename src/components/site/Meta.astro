---
// Title, description, canonical and social tags for a marketing page.
import { site } from '../../data/site';

interface Props {
  /** The page name, used for the social title and, with the site name, the <title>. */
  title: string;
  description: string;
  /** Site-relative path of the social image. */
  ogImage?: string;
  /** The whole <title>, when "Page | Cabbage" is not what is wanted. */
  fullTitle?: string;
  /** Keeps the page out of search results. It then has no canonical URL either. */
  noindex?: boolean;
}
const { title, description, ogImage, noindex = false } = Astro.props;
const fullTitle = Astro.props.fullTitle ?? (title === site.name ? title : `${title} | ${site.name}`);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content="summary_large_image" />
