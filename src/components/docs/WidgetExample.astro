---
// The example panel at the top of a widget page: a preview slot, the example
// file name, and buttons to copy or download the file.
//
// Usage in MDX: <WidgetExample name="rotarySlider" />
//
// The preview shows public/img/widgets/<name>.png when that file exists and
// is left out otherwise. A live preview can replace the image later: it
// belongs in the .cb-example__preview element.
import { join } from 'node:path';
import sharp from 'sharp';
import { getExample } from '../../lib/examples';

interface Props {
  /** Widget type, matching public/examples/<name>.csd. */
  name: string;
}
const { name } = Astro.props;
const example = getExample(name);

// Explicit width and height keep the page from shifting as the image loads.
let size: { width?: number; height?: number } = {};
if (example.screenshot) {
  size = await sharp(join(process.cwd(), 'public', example.screenshot)).metadata();
}
---

<div class="cb-example not-content">
  {
    example.screenshot && (
      <div class="cb-example__preview">
        <img
          src={example.screenshot}
          alt={`The ${name} example running in Cabbage`}
          width={size.width}
          height={size.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
  <div class="cb-example__bar">
    <span class="cb-example__file">{example.fileName}</span>
    <div class="cb-example__actions">
      <button type="button" class="btn btn-quiet btn-sm" data-copy-example={example.href} hidden>Copy example</button>
      <a class="btn btn-quiet btn-sm" href={example.href} download={example.fileName}>Download .csd</a>
    </div>
    <span class="visually-hidden" role="status" data-copy-status></span>
  </div>
</div>

<script>
  import '../../scripts/copy-example.js';
</script>

<style>
  .cb-example {
    margin-top: 1.75rem;
    overflow: hidden;
    border: 1px solid var(--cb-line);
    border-radius: var(--cb-radius-lg);
  }
  .cb-example__preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    padding: 24px;
    border-bottom: 1px solid var(--cb-line);
    background: var(--cb-chrome);
  }
  .cb-example__preview img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .cb-example__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 8px 8px 8px 16px;
  }
  .cb-example__file {
    font-family: var(--cb-font-mono);
    font-size: var(--cb-text-code);
    color: var(--cb-muted);
  }
  .cb-example__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
